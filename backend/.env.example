# Copy to backend/.env and fill in. backend/.env is git-ignored.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_CREDENTIALS_FILE=firebase-adminsdk.json   # file name inside backend/secrets/
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/vision-service-account.json
VERYFI_CLIENT_ID=
VERYFI_CLIENT_SECRET=
VERYFI_USERNAME=
VERYFI_API_KEY=
